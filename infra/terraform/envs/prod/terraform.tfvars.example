# Copy to terraform.tfvars (git-ignored) and fill in. No real ids belong in this file.
project_id = "axon-trader-prod-placeholder"
region     = "us-central1"

subnet_cidr   = "10.20.0.0/20"
pods_cidr     = "10.22.0.0/16"
services_cidr = "10.23.0.0/20"

artifact_registry_immutable_tags  = true
artifact_registry_cleanup_dry_run = false

kubernetes_namespace                  = "axon-trader"
enable_gke_workload_identity_bindings = false

wif_pool_id       = "esarch-ci-prod"
github_repository = "COG-GTM/ESarch"
# gh api repos/<owner>/<name> --jq '.id, .owner.id'
github_repository_id       = "REPLACE_WITH_NUMERIC_REPOSITORY_ID"
github_repository_owner_id = "REPLACE_WITH_NUMERIC_OWNER_ID"
ci_allowed_refs   = ["refs/heads/master"]
# Only jobs of the `production` GitHub environment (required reviewers) get prod tokens (.github/workflows/deploy-prod.yml).
ci_allowed_environments = ["production"]

# GKE Autopilot (regional, private nodes). Add the operator/CI egress CIDRs that run kubectl.
gke_master_ipv4_cidr_block = "172.16.0.16/28"
gke_master_authorized_networks = [
  # { cidr_block = "203.0.113.0/24", display_name = "ops-vpn" },
]
gke_deletion_protection = true

# DNS names served by the Gateway (Google-managed certificate). Point each at the gateway_address output.
gateway_hostnames = ["trader.example.com"]

# Observability: Cloud SQL instances on the dashboards (empty = all) and alert recipients.
cloudsql_instance_names   = []
alert_notification_emails = [
  # "axon-trader-oncall@example.com",
]

labels = {
  team = "REPLACE_WITH_TEAM"
}

# Cloud SQL for MySQL 8.0 (private IP; databases appdb/enginedb, users trader-app/trading-engine).
cloudsql_tier                           = "db-custom-2-7680"
cloudsql_availability_type              = "REGIONAL"
cloudsql_point_in_time_recovery_enabled = true
cloudsql_retained_backups               = 30
cloudsql_deletion_protection            = true
